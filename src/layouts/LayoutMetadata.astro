---
interface Props {
	pageTitle: string;
	description: string;
}

const { pageTitle } = Astro.props;
const { description } = Astro.props;
/*import "the-new-css-reset";*/
const favicon = import.meta.env.DEV
  ? "/favicon-dev.png"
  : "/favicon.png";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<!--meta name="description" content="Astro description" /-->
		<meta name="viewport" content="width=device-width" />
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/destyle.css@1.0.15/destyle.css"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600&display=swap" rel="stylesheet">

		<!-- ogp設定用 -->
        <meta property="og:title" content={pageTitle+" - シャーロットエースの部屋"}>
        <meta property="og:type" content="website">
        <meta property="og:url" content="/">
        <meta property="og:image" content="https://charlotteace.github.io/favicon.png">
        <meta property="og:site_name" content="シャーロットエースの部屋">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:image" content=https://charlotteace.github.io/favicon.png>
        <meta property="og:description" content={description}>
        <meta property="og:locale" content="jp">
		
        <!-- 先に読み込むデータ -->
		<link rel="icon" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle+" - シャーロットエースの部屋"}</title>
	</head>
	<body>
		<slot />
	</body>
</html>