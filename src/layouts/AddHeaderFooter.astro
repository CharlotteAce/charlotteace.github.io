---
import AceHead from '@src/layouts/AceHead.astro';
import Header from '@src/components/Header.astro';
import Footer from '@src/components/Footer.astro';
import '@src/styles/style_v2.css';
const { pageTitle } = Astro.props;
const { pageUrl } = Astro.props;
const { description } = Astro.props;
---

<AceHead pageTitle={ pageTitle } pageUrl={ pageUrl } description={ description }>
  <div id="wrapper">
    <Header />
    <slot />
  </div>
  <Footer pageTitle={pageTitle} pageUrl={pageUrl}/>
</AceHead>

