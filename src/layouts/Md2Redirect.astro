---
import A from '@src/components/A.astro';

import AddHeaderFooter from '@src/layouts/AddHeaderFooter.astro';
const { frontmatter } = Astro.props;
const { redirectDelay: propRedirectDelay } = Astro.props;

const redirectDelay =
  typeof frontmatter?.redirectDelay === 'number'
    ? frontmatter.redirectDelay
    : typeof propRedirectDelay === 'number'
      ? propRedirectDelay
      : 3;
---

<AddHeaderFooter pageTitle={ frontmatter.title } pageUrl={ frontmatter.pageUrl } description={ frontmatter.description } canonical={ frontmatter.contentsUrl } noindex=true>
  <p>
    閲覧リンクはこちら：<A href={frontmatter.contentsUrl}>{frontmatter.contentsUrl}</A><br>
    {redirectDelay}秒後に自動リダイレクトします。
  </p>
  <meta http-equiv="refresh" content={redirectDelay+";URL='"+frontmatter.contentsUrl+"'"}>
</AddHeaderFooter>