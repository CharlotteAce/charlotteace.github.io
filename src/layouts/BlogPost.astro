---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const { param } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('@src/images/logos/*.{jpeg,jpg,png,gif}')
const logo_url = "/src/images/logos/"
if (!images[logo_url+param.medium+".png"]) throw new Error(`"${logo_url+param.medium+".png"}" does not exist in glob: "images/logos/*.{jpeg,jpg,png,gif}"`);
---

<div class="card">
    <div class={"card-h4"+param.width.four+" card-h3"+param.width.three+" card-h2"+param.width.two}>
        <div class={param.medium}>
            <div class="text">
                <h3 class="content-1">{param.title}</h3>
                <p class="content-2">{param.pubDate}</p>
                <p class="content-3">
                    {param.description}
                </p>
            </div>
            <Image class="logo" src={images[logo_url+param.medium+".png"]()} alt={param.medium+".com"} height="60"/>
            <!--img class={"logo_"} src={"/images/logos/"+param.medium+".png"} height="30" alt={param.medium+".com"}-->
            </style>
            <a href={param.contentsUrl} target="_blank" rel="noopener noreferrer"></a>
        </div>
        <div class="thumbnail" style={"background-image:url("+param.image.url+")"}></div>
    </div>
</div>