---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.param.title} pageUrl={frontmatter.param.pageUrl} pubDate={frontmatter.param.pubDate} updateDate={frontmatter.param.updateDate} medium={frontmatter.param.medium} width={frontmatter.param.width}>
    <slot />
</BaseLayout>