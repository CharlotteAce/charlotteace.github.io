---
import BaseLayout from '@src/layouts/BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title} pageUrl={frontmatter.pageUrl} pubDate={frontmatter.pubDate} updateDate={frontmatter.updateDate} medium={frontmatter.medium} width={frontmatter.width}>
    <slot />
</BaseLayout>