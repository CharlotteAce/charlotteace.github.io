---
import Layout from '@src/layouts/Layout.astro';
import '@src/styles/style.css';
import '@src/styles/mobilestyle.css';
import '@src/styles/printstyle.css';
/*import Card from '../components/Card.astro';*/
const { pageTitle } = Astro.props;
const { pageUrl } = Astro.props;
const { pubDate } = Astro.props;
const { updateDate } = Astro.props;
---

<Layout title={pageTitle}>
	<main>
        <div id="header">
			<header class="c-header c-hamburger-menu">
				<a href="https://charlotteace.github.io" id="mainlogo">シャーロットエースの部屋</a>
				<input type="checkbox" name="hamburger" id="hamburger" class="c-hamburger-menu__input"/><!-- idはlabelのforと同じにする -->
				<label for="hamburger" class="c-hamburger-menu__bg"></label><!-- ハンバーガーメニュを開いた時の背景 -->
				<ul class="c-header__list c-hamburger-menu__list"><!-- クラスを追記 -->
					<li class="c-header__list-item">
						<a href="https://charlotteace.github.io" class="c-header__list-link">トップ</a>
					</li>
					<li class="c-header__list-item">
						<a href="https://charlotteace.github.io/contents/" class="c-header__list-link">記事</a>
					</li>
				</ul>
				<label for="hamburger" class="c-hamburger-menu__button"><!-- ハンバーガーメニューのボタン -->
					<span class="c-hamburger-menu__button-mark"></span>
					<span class="c-hamburger-menu__button-mark"></span>
					<span class="c-hamburger-menu__button-mark"></span>
				</label>
			</header>
		</div>
        <div class="wrapper">
            <h1 id="info">{pageTitle}</h1>
            <small id="date">公開：{pubDate}・最終更新：{updateDate}</small>
			
            <slot />
			<div id="footer">
				<p class="button"><a href={"https://twitter.com/intent/tweet?text=%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%E3%82%92%E8%A8%AA%E3%82%8C%E3%81%BE%E3%81%97%E3%81%9F%EF%BC%81%0A%0A"+encodeURI(pageTitle)+"%20-%20%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%0Ahttps%3A%2F%2Fcharlotteace.github.io"+encodeURI(pageUrl)} target="_blank" rel="noopener noreferrer">𝕏で共有</a></p>
				<small>&copy;Copyright 国際単位系/シャーロットエース. All rights reserved.</small>
			</div>
        </div>
	</main>
</Layout>

