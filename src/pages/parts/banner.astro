---
import AceHead from '@src/layouts/AceHead.astro';
import { Image } from 'astro:assets';
import aceLogo from '@src/images/logos/ace.png';
const pageTitle = "トップページ";
const description = "埋め込み用バナー";
const canonical = "/";
const noindex = true;
---

<AceHead pageTitle={ pageTitle } description={ description } canonical={ canonical } noindex={ noindex }>
  <body>
    <style>
      @charset "utf-8";
      @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600&display=swap');

      /* webページ全体に適用 */
      body {
        font-family: 'Noto Sans JP', sans-serif;
        font-size: min(50vh,calc(8vw));
        margin: 0;
        padding: 0;
        color: white;
        
        background-color: #1C4D8C;
        display: flex;
        justify-content: center;
        align-items: center;
        position:relative;
        height: 100dvh;
        line-height: 1.2em;
      }
      @media (prefers-color-scheme: dark) {
        body {
            background-color: #182f60;
        }
      }
      a {
        position: absolute;
        top: 0;
        left: 0;
        height:100%;
        width: 100%;
      }
      .wapper, .banner, p{
        margin: 0;
        padding: 0;
      }
      .wapper{
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        width:100%;
      }
      #logo {
        width: min(100vh, 100vw);
        height: min(100vh, 100vw);
        width: min(100dvh, 100vw);
        height: min(100dvh, 100vw);
      }
      body{font-size: min(72vh,calc((90vw - 10px) * 0.24));}
      #si, #room{display: initial;}
      #logo, #charlotte, #br1, #ace, #br2{display: none;}
      @media (min-aspect-ratio: 9/4) {
        body{font-size: min(66vh,calc((90vw - 10px) * 0.16));}
        #ace, #room{display: initial;}
        #logo, #si, #charlotte, #br1, #br2{display: none;}
      }
      @media (min-height: 48px){
        body{font-size: min(22vh,calc((90vw - 10px) * 0.16));}
          #charlotte, #br1, #ace, #room{display: initial;}
          #logo, #si, #br2{display: none;}
        @media (min-height: 72px) {
          body{font-size: min(22vh,calc((90vw - 10px) * 0.16));}
          #charlotte, #br1, #ace, #br2, #room{display: initial;}
          #logo, #si{display: none;}
        }
        @media (min-aspect-ratio: 7/2) {
          body{font-size: min(33vh,calc((90vw - 10px) * 0.1));}
          #charlotte, #ace, #br2, #room{display: initial;}
          #logo, #si, #br1{display: none;}
        }
      }      
      @media (min-aspect-ratio: 9/2) {
        body{font-size: min(66vh,calc((90vw - 10px) * 0.08));}
        #charlotte, #ace, #room{display: initial;}
        #logo, #si, #br1, #br2{display: none;}
      }
      @media (max-aspect-ratio: 5/4) {
        #logo {display: initial;}
        #si, #charlotte, #br1, #ace, #br2, #room{display: none;}
      }
      
    </style>
		<div class="wrapper">
      <div class="banner">
        <p>
          <span id="si">SIの</span><span id="charlotte">シャーロット</span><br id="br1"><span id="ace">エースの</span><br id="br2"><span id="room">部屋</span>
        </p>
        <Image id="logo" src={aceLogo} alt="site's logo" />
      </div>
      <a href="https://charlotteace.github.io" target="_blank"></a>
		</div>
  </body>
</AceHead>