---
import LayoutBlog from '@src/layouts/LayoutBlog.astro';
import A from '@src/components/A.astro';
//import IconRemote from '@src/components/IconRemote.astro';
//import IconSNS from '@src/components/IconSNS.astro';

// events
import { marked } from "marked";
import eventData from "@src/data/events.yml";
import type { EventData } from "@src/types/ymlData";
const events = eventData as EventData;
const upcoming = events.events.filter(
  e => e.status === "upcoming"
);
const past = events.events.filter(
  e =>
    e.status === "past" ||
    e.status === "cancelled"
);

// hitokoto
import hitokotoList from '@src/data/hitokoto.yml';
import type { Hitokoto } from '@src/types/ymlData';
const [hitokotoRecent, ...hitokotoArchive]: Hitokoto[] = hitokotoList;

// link_exchange
import linksData from '@src/data/link_exchange.yml';
import type { LinkExchange } from '@src/types/ymlData';
const links = linksData as LinkExchange[];

const pageTitle = "プロフィール";
const pageUrl = "/profile";
const pubDate = "2023-12-20";
const pageUpdateDate = "2026-05-21";
const updateDatesList = [pageUpdateDate, hitokotoRecent.date, eventData.updated];
const updateDate = updateDatesList.reduce((max, current) => current > max ? current : max);
const description = "しのはら恵の自己紹介。";
const tags :string[] = [];



import { Image } from 'astro:assets';
import aceFace from '@src/images/charlotteace001.png';
---
<LayoutBlog pageTitle={pageTitle} pageUrl={pageUrl} pubDate={pubDate} updateDate={updateDate} description={description} tags={tags}>
  <p>&emsp;このページでは私の自己紹介を掲載しています。これといって重要な情報はありませんが……『非公開』とされているものを何らかの手段で知ってしまったみなさんは、どうか心の内側にとどめていただきますよう。今日のひとことは不定期更新です。</p>
  <h2>シャーロットエース/<wbr>しのはら恵/<wbr>国際単位系</h2>
  <style>
    #profile_container{
      display: flex;
      justify-content: start;
      align-items: start;
    }
    #ace_face{
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 300px;
      margin: 4rem 4rem 0 0;
      padding-top: 0.6rem;
      
    }
    #ace_face img{
      width: 100%;
      height: auto;
      border: 0.2rem solid var(--charlotteace-deep);
    }
    @media screen and (max-width: 863px){
      #profile_container{display: block;}
      #ace_face{
        width: 100%;
        max-width: 300px;
        margin: 4rem auto 0;
      }
    }
  </style>
  <div id="profile_container">
    <div id="ace_face">
      <Image src={aceFace} alt="charlotteace's face" />
      <small class="alt">Illustration by 春瀬(宇田まなと)</small>
    </div>
    <div>
      <h3>基本データ</h3>
      <ul>
        <li>
          生年月日
          <ul>
            <li>非公開</li>
          </ul>
        </li>
        <li>
          身分
          <ul>    
            <li>理工系学科 修士二年</li>
            <li>同人ライター（<A href="/contents/kagefumi">ウマ娘聖地巡礼情報誌『カゲフミ！』シリーズ</A>他）</li>
            <li>同人編集者兼売り子</li>
            <li>おたく</li>
          </ul>
        </li>
        <li>
          所属と活動
          <ul>    
            <li><A href="https://portal.circle.ms/Circle/Index/10458074">サークル『天然ウナギ専門店』</A>　ライター、編集者、売り子</li>
            <li><A href="https://portal.circle.ms/Circle/Index/10456708">サークル『逆たまごかけごはん』</A>　発注担当、売り子</li>
            <li><A href="https://portal.circle.ms/Circle/Index/10510253">個人サークル『どんぶりめし』</A>　代表</li>
            <li><A href="https://comitech-official.github.io">工大祭即売会『こみてっく！』(仮称)準備会</A>　副代表</li>
            <li><A href="https://x.com/nyan_rank">にゃーんRanker</A>　運営者</li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
  
  <h3>アカウント集</h3>
  <!--a href="https://x.com/Units_SI">
    <Image src="https://unavatar.io/x/units_si" width={64} height={64} alt="twitterアカウント @units_si のアイコン" />
    @Units_SI
  </A>
  <IconRemote provider="x" username="units_si"/>
  <IconSNS provider="x" domain="x.com" username="units_si"/-->
  <ul>    
    <li><A href="https://x.com/Units_SI">@Units_SI - twitter.com</A></li>
    <li><A href="https://x.com/_shinoharaK">@_shinoharaK - twitter.com</A></li>
    <li><A href="https://note.com/units_si">@units_si - note</A></li>
    <li><A href="https://github.com/CharlotteAce/">CharlotteAce - github</A></li>
  </ul>
  <h3>趣味</h3>
  <p>&emsp;美術館・博物館めぐり、<wbr>旅行、<wbr>鉄道、<wbr>パソカタ、<wbr>料理（つくるほう）、<wbr>食事（たべるほう）、<wbr>野球、<wbr>ピアノ　など</p>
  <h3>名前の由来</h3>
  <p>&emsp;最初のハンドルネーム『国際単位系』は、最初のTwitter（当時）アカウント開設時<sup><A href="#user-content-fn-1" id="user-content-fnref-1" data-footnote-ref="" aria-describedby="footnote-label">1</A></sup>に、脳内ランダムワード生成で出力された単語。当時2進接頭辞と10進接頭辞の混同問題について考えていたため、適当な単語を考えた時にこれが出てきてしまった。</p>
  <p>&emsp;ニックネーム『シャーロットエース』は、ウマ娘<sup><A href="#user-content-fn-2" id="user-content-fnref-2" data-footnote-ref="" aria-describedby="footnote-label">2</A></sup>らしいニックネームをつけるべく命名された。「SI<sup><A href="#user-content-fn-3" id="user-content-fnref-3" data-footnote-ref="" aria-describedby="footnote-label">3</A></sup>」から採った「シ」を頭文字に、私が数年間<sup><A href="#user-content-fn-4" id="user-content-fnref-4" data-footnote-ref="" aria-describedby="footnote-label">4</A></sup>打ち込んでいた野球に由来する「エース<sup><A href="#user-content-fn-5" id="user-content-fnref-5" data-footnote-ref="" aria-describedby="footnote-label">5</A></sup> 」を組み合わせた。「シャーロット」には別の由来もあるのだが、これをお話するのはまたの機会に。</p>
  <p>&emsp;ペンネーム『しのはら恵』は、<A class="color" href="https://charlotteace.booth.pm/items/5999336">『カゲフミ！　vol. 1』</A>の刊行にあたり、本名らしいペンネームが欲しくなり付けた名前。「し（＝SI）」から始まる名字に、「系」と同音で読める「恵」とした。漢字の読み方は指定していない。</p>
  <h3>ファンアートタグ</h3>
  <p>&emsp;<A href="https://x.com/search?q=%23%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E7%B5%B5%E3%83%BC%E3%82%B9%20filter%3Aimages&src=typed_query&f=live">#にゃらんかあーと</A>（にゃーんRanker）</p>
  <h2 id="hitokoto">今日のひとこと</h2>
  <blockquote>
    <p>{hitokotoRecent.text}</p>
  </blockquote>
  <p class="reference">（{hitokotoRecent.date}更新）</p>
  <details>
    <summary><span>過去のひとこと</span></summary>
    <blockquote>
      {
        hitokotoArchive.map((item) => (
          <p>
            {item.text}（{item.date}更新{item.note ? `、${item.note}` : ''}）
          </p>
        ))
      }
    </blockquote>
  </details>
  <h2>イベント出展情報</h2>
  <p>
    &emsp;【天】は天然ウナギ専門店、【逆】は逆たまごかけごはん、【ど】はどんぶりめし名義での出展です。
  </p>
  {
    upcoming.map((event) => (
      <>
        <h3>
          【{event.circle}】{event.title}
        </h3>

        <Fragment
          set:html={marked.parse(event.body)}
        />
      </>
    ))
  }

  <!-- p>&emsp;現在決定済みの出展イベントはありません。</p -->
  
  <p></p>
  <details>
    <summary><span>過去の出展イベント</span></summary>
    <p>
      &emsp;出展イベントの参加レポートや刊行物は<A href="/contents/tags/%E5%90%8C%E4%BA%BA%E6%B4%BB%E5%8B%95/">こちら</A>から。
    </p>
    {
      past.map((event) => (
        <>
          <h3>
            【{event.circle}】{event.title}
          </h3>

          <Fragment
            set:html={marked.parse(event.body)}
          />
        </>
      ))
    }  
  </details>
  <h2>相互リンク</h2>
  <p>
    &emsp;現在はこちらからお声掛けした方のみ掲載をしております。申請フォーム公開までしばらくお待ちください。相互リンク掲出ご希望の方はSNSなどで個別にお声掛けください。
  </p>
  <details>
    <summary>ご自身のサイトに、弊サイトのリンクを掲載したい方へ</summary>
    &emsp;掲出はご自由にどうぞ。リンク先は<A href="https://charlotteace.jp/" target="_blank" rel="noopener noreferrer">トップページ</A>へお願いします。バナーが必要な場合は、<A href="https://charlotteace.jp/parts/banner/" target="_blank" rel="noopener noreferrer">https://<wbr>charlotteace.<wbr>jp/<wbr>parts/<wbr>banner/</A> を<code>&lt;iframe&gt;</code>属性にてそのまま埋め込んでいただくか、チャプチャのうえでお使いください。バナーサイズについての規程はありません（ご設定のサイズに応じて最適化されます）。ページ全体に<code>&lt;a&gt;</code>属性が設定されているため、埋め込みの場合には、その他の設定はご不要です。
  </details>
  <style>
    .linkcard_box{
      margin: 2rem 0 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.6rem;
    }
    .linkcard, .linktext, .banner {
      --link-sub-color:white;
      --link-theme-color: var(--charlotteace-theem);
      --link-theme-color-light:var(--charlotteace-theme);
      --link-theme-color-dark:var(--link-theme-color-light);
      --link-theme-color:var(--link-theme-color-light);
      --text-display-boolean:0;
    }
    .linkcard, .linktext, .banner {
      --linkcard-bg-color: color-mix(in srgb, var(--charlotteace-water) 10%, transparent);
      --linkcard-border: var(--charlotteace-water);
      --linkcard-border-active: var(--charlotteace-deep);    
    }
    @media (prefers-color-scheme: dark) {
      .linkcard, .linktext, .banner {
        --link-theme-color:var(--link-theme-color-dark);
        --linkcard-bg-color: color-mix(in srgb, var(--charlotteace-theme) 20%, transparent);
        --linkcard-border: var(--charlotteace-theme);
        --linkcard-border-active: var(--link-theme-color);    
      }
    }
    .linkcard{
      display:inline-block;
      width: 24rem;
      height: 13.5rem;
      border: 1px solid var(--linkcard-border);
      border-radius: 0.8rem;
      background-color: var(--linkcard-bg-color);
      overflow: hidden;
    }
    .linkcard .border_left{
      width: 100%;
      height: 100%;
      border-left: 0.8rem solid var(--link-theme-color);
      position: relative;
    }
    .linkcard .thumbnail{
      position: absolute;
    }
    .linkcard:hover .thumbnail,.linkcard:active .thumbnail,.linkcard:focus .thumbnail{
      opacity: 0.2;
    }
    .linkcard .card_data{
      position: absolute;
      color: var(--main-font-color);
      padding:0.8rem 1.6rem;
      opacity: var(--text-display-boolean);
    }
    .linkcard:hover,.linkcard:active,.linkcard:focus {
      border: 1px solid var(--linkcard-border-active);
      background-color: color-mix(in srgb, var(--link-theme-color) 80%, transparent);
    }
    .linkcard:hover .card_data,.linkcard:active .card_data,.linkcard:focus .card_data{
      opacity: 1;
      color: var(--link-sub-color);
    }
    .linkcard .card_data h2{
      margin: 0;
      padding: 0;
    }
    .linkcard .card_data p{
      margin: 0.2rem 0 0;
      padding: 0;
    }
    .linkcard .logo{
      position: absolute;
      left: 1.6rem;
      bottom: 0.8rem;
      height:2.4rem;
      width:auto;
      opacity:1;
    }
    .linkcard .thumbnail{
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: x y;
      object-position: 50% 50%; /* 中央表示 */
    }
    .banner{
      margin:0;
      border: 0.2rem solid transparent;
    }
    .banner:hover, .banner:active, .banner:focus{
      border: 0.2rem solid var(--link-theme-color);
    }
    .linktext{
      margin: 0;
      padding: 0.4rem;
      border-bottom: 0.2rem solid var(--link-theme-color);
    }

    .banner, .linktext{display: none;}
    @media screen and (max-width: 588px) {
      .linkcard_box{
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.6rem;
      }
      .linkcard{display: none;}
      .banner, .linktext{
        display: block;
        margin: 0 auto;
        width: max-content;
      }
    }
  </style>
  <div class="linkcard_box">
    {
      links.map((link) => (
        <>
          <A
            class="linkcard"
            href={link.url}
            style={`
              --link-theme-color-light:${link.themeColor};
              --link-sub-color:${link.subColor};
              --text-display-boolean:${link.textDisplay};
              ${link.darkThemeColor ? `--link-theme-color-dark:${link.darkThemeColor};` : ''}
            `}
          >
            <div class="border_left">

              {link.thumbnail && (
                <img
                  class="thumbnail"
                  src={link.thumbnail}
                  alt={link.thumbnailAlt ?? `『${link.name.replace(/\n/g,'')}』のサムネイル`}
                />
              )}

              <div class="card_data">
                <h2>{link.name}</h2>
                <p>{link.author}</p>
              </div>

              {link.logo && (
                <img
                  class="logo"
                  src={link.logo}
                  alt={`『${link.name.replace(/\n/g,'')}』のfavicon`}
                />
              )}

            </div>
          </A>

          {
            link.banner
              ? (
                <A
                  class="banner"
                  href={link.url}
                  style={`
                    --link-theme-color:${link.themeColor};
                    ${link.darkThemeColor ? `--link-theme-color-dark:${link.darkThemeColor};` : ''}
                  `}
                >
                  <img
                    src={link.banner}
                    alt={`『${link.name.replace(/\n/g,'')}』のバナー`}
                    width="200"
                    height="40"
                  />
                </A>
              )
              : (
                <div
                  class="linktext"
                  style={`
                    --link-theme-color-light:${link.themeColor};
                    ${link.darkThemeColor ? `--link-theme-color-dark:${link.darkThemeColor};` : ''}
                  `}
                >
                  <big><A href={link.url}>{link.name}</A></big>
                  {' '} - {link.author}
                </div>
              )
          }
        </>
      ))
    }
  </div>

  <section data-footnotes="" class="footnotes"><h2 class="sr-only" id="footnote-label">注釈</h2>
  <ol>
  <li id="user-content-fn-1"><p>
    最初のアカウントは高校3年の8月に作成した。Twitterをやめていた友人たちのうち何人かはこれを機に戻ってきてしまった。大戦犯である。
    <A href="#user-content-fnref-1" data-footnote-backref="" aria-label="Back to reference 1" class="data-footnote-backref">↩</A>
  </p></li>
  <li id="user-content-fn-2"><p>
    私が没頭しているゲーム『ウマ娘 プリティーダービー』に登場する、現実世界の競走馬の名前と高い身体能力をもつ少女たちの種族名。つまるところ競走馬にありそうなニックネームが欲しかったわけだ。
    <A href="#user-content-fnref-2" data-footnote-backref="" aria-label="Back to reference 2" class="data-footnote-backref">↩</A>
  </p></li>
  <li id="user-content-fn-3"><p>
    国際単位系はフランス語で Système international d'unités と書き、SIと略す。親しい友人の中には私の事を「しーちゃん」と呼ぶ者もいる。
    <A href="#user-content-fnref-3" data-footnote-backref="" aria-label="Back to reference 3" class="data-footnote-backref">↩</A>
  </p></li>
  <li id="user-content-fn-4"><p>
    小学3年の9月から中学3年の8月まで。
    <A href="#user-content-fnref-4" data-footnote-backref="" aria-label="Back to reference 4" class="data-footnote-backref">↩</A>
  </p></li>
  <li id="user-content-fn-5"><p>
    小学校の頃に所属していた学童野球チームには、私の同級生はもう一人しかいなかった。彼はキャプテンナンバー#10を背負ってキャッチャーを、私はエースナンバー#1を背負ってピッチャーを務めていた。これでも一応いちチームのエースだったのだ、他に誰もいないから当然であるが。
    <A href="#user-content-fnref-5" data-footnote-backref="" aria-label="Back to reference 5" class="data-footnote-backref">↩</A>
  </p></li>
  </ol>
  </section>
</LayoutBlog>