---
import LayoutBlog from '@src/layouts/LayoutBlog.astro';
import LinkCard from '@src/components/LinkCard.astro';
const pageTitle = "制作物・記事一覧";
const pageUrl = "/contents";
const pubDate = "2023-12-20";
const updateDate = "2025-10-17";
const description = "しのはら恵の制作物紹介。";
const tags :string[] = [];
const allPosts = await Astro.glob('@src/pages/blogs/*.md');
allPosts.sort((a, b) => {
    return b.frontmatter.contentsNum - a.frontmatter.contentsNum;
});
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---
<LayoutBlog pageTitle={pageTitle} pageUrl={pageUrl} pubDate={pubDate} updateDate={updateDate} description={description} tags={tags}>
    <p>
        &emsp;このページでは私(国際単位系/しのはら恵/シャーロットエース)の投稿した記事や関与したコンテンツの一覧を掲載しています。
        カードをクリックすると記事のページへジャンプします。
    </p>
	<style>
		.linkcard_box{
			margin: 2rem 0 0;
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 1.6rem;
		}
	</style>
    <div class="linkcard_box">
        <!-- 逆たまコンピの上でいったん改行位置 -->
        <!-- カゲフミ！１の上でいったん改行位置 -->
        {allPosts.map((post) => <LinkCard frontmatter={post.frontmatter}/>)}
    </div>
</LayoutBlog>