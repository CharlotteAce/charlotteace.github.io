---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
const allPosts = await Astro.glob('../blogs/*.md');
allPosts.sort((a, b) => {
  return b.frontmatter.param.contentsNum - a.frontmatter.param.contentsNum;
});
const pageTitle = "制作物・記事一覧";
const pageUrl = "/contents";
const pubDate = "2023-12-20";
const updateDate = "2025-01-30";
---
<BaseLayout pageTitle={pageTitle} pageUrl={pageUrl} pubDate={pubDate} updateDate={updateDate}>
	<p class="info_item">
        このページでは私(国際単位系/しのはら恵/シャーロットエース)の投稿した記事や関与したコンテンツの一覧を掲載しています。
        カードをクリックすると記事のページへジャンプします。
    </p>
    <div class="card-group">
    
        <!-- 逆たまコンピの上でいったん改行位置 -->
        <!-- カゲフミ！１の上でいったん改行位置 -->
        {allPosts.map((post) => <BlogPost param={post.frontmatter.param}/>)}
    </div>
</BaseLayout>