---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
const allPosts = await Astro.glob('../blogs/*.md');
allPosts.sort((a, b) => {
  return b.frontmatter.param.contentsNum - a.frontmatter.param.contentsNum;
});
const pageTitle = "制作物・記事一覧";
const pageUrl = "/contents";
const pubDate = "2023-12-20";
const updateDate = "2024-08-04";
---
<BaseLayout pageTitle={pageTitle} pageUrl={pageUrl} pubDate={pubDate} updateDate={updateDate}>
	<p class="info_item">
        このページでは私(国際単位系/しのはら恵/シャーロットエース)の投稿した記事や関与したコンテンツの一覧を掲載しています。
        カードをクリックすると記事のページへジャンプします。
    </p>
    <div class="card-group">
        <div class="card">
            <div class="card-h4b card-h3b card-h2d">
                <div class="note">
                    <div class="text">
                        <h3 class="content-1">五月祭<wbr>コミアカ<wbr>衣装<wbr>制作記<wbr>「同人は<wbr>そんなに<wbr>甘く<wbr>ないよ…」</h3>
                        <p class="content-2">2024-05-21</p>
                        <p class="content-3">
                            前回『コミアカ新歓衣装制作記「何事もトライしなくちゃ分からないよ！」』で作成した、小美亜佳子さんのお友達の衣装を納品したお話です。制作したのは、東京大学内の同人誌即売会運営サークル「コミックアカデミー実行委員会（コミアカ）」公式キャラクター、轍夜明さんの衣装です。……
                        </p>
                    </div>
                    <a href="https://note.com/units_si/n/nf48bdd553880"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/note.png" width="80" height="30" alt="note.com"></a>
                </div>
                <div class="thumbnail" style="background-image:url('https://assets.st-note.com/production/uploads/images/141337685/rectangle_large_type_2_28533c84fb4c6c73ca774aaf9e9fe6a1.jpeg')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4e card-h3e card-h2e">
                <div class="amazon">
                    <div class="text">
                        <h3 class="content-1">ほしいものリスト<wbr>「芋」</h3>
                        <p class="content-2"></p>
                        <p class="content-3"></p>
                    </div>
                    <img src="../images/logo/amazon.png" width="80" height="30" alt="amazon.com">
                    <a href="https://www.amazon.co.jp/hz/wishlist/ls/18W7NK9PVEXGW"target="_blank" rel="noopener noreferrer"></a>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4e card-h3d card-h2e">
                <div class="note">
                    <div class="text">
                        <h3 class="content-1">コミアカ<wbr>新歓<wbr>衣装<wbr>制作記<wbr>「何事も<wbr>トライ<wbr>しなくちゃ<wbr>分から<wbr>ないよ！」</h3>
                        <p class="content-2">2024-04-25</p>
                        <p class="content-3">
                            私が初めてのコスプレ衣装制作を受注した話について書きました。作成したのは、東京大学内の同人誌即売会運営サークル「コミックアカデミー実行委員会（コミアカ）」公式キャラクター、小美亜佳子さんの衣装です。……
                        </p>
                    </div>
                    <a href="https://note.com/units_si/n/n9494146d2770"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/note.png" width="80" height="30" alt="note.com"></a>
                </div>
                <div class="thumbnail" style="background-image:url('https://assets.st-note.com/production/uploads/images/138388749/rectangle_large_type_2_72f99ee38e654657505bcf6716df5deb.png')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4e card-h3c card-h2e">
                <div class="ace">
                    <div class="text">
                        <h3 class="content-1">信州<wbr>諏訪<wbr>探訪 <wbr>雪と<wbr>酒と<wbr>湖と</h3>
                        <p class="content-2">2024-02-26</p>
                        <p class="content-3">
                            私のTwitterを追っていると、ずいぶんと信州旅行が多いように見えるかもしれない。勘のいい人々はお気づきかもしれないが、私の実家のひとつは南信州(南信)の某所にある。……
                        </p>
                    </div>
                    <a href="https://charlotteace.github.io/blogs/202402260001"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/ace.png" width="30" height="30" alt="ace's logo">
                </div>
                <!--div class="thumbnail" style="background-image:url('https://pbs.twimg.com/media/GChLziWa8AAbgAo.png')"></div-->
            </div>
        </div>
        <div class="card">
            <div class="card-h4e card-h3c card-h2e">
                <div class="note">
                    <div class="text">
                        <h3 class="content-1">C103<wbr>参戦記<wbr>（下）<wbr>「季節、<wbr>ひと巡り、<wbr>冬」</h3>
                        <p class="content-2">2024-01-07</p>
                        <p class="content-3">
                            すっかり習慣となりました、コミケ参戦記の後編です。私のお手伝いしているサークルには、即売会前日に私の家に泊まる謎の風習があります。私は動画編集を、でぃめは無料配布ペーパーの原稿を描く限界同人部屋の完成です。……
                        </p>
                    </div>
                    <a href="https://note.com/units_si/n/n58805b5dcd31"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/note.png" width="80" height="30" alt="note.com"></a>
                </div>
                <div class="thumbnail" style="background-image:url('https://pbs.twimg.com/media/GChLziWa8AAbgAo.png')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4d card-h3d card-h2d">
                <div class="ace">
                    <div class="text">
                        <h3 class="content-1">すいかもん<wbr>ゲーム<wbr>(β)</h3>
                        <p class="content-2">2024-01-06</p>
                        <p class="content-3">
                            β版(試作版)です。
                        </p>
                    </div>
                    <img src="../images/logo/ace.png" width="30" height="30" alt="ace's logo">
                    <a href="https://charlotteace.github.io/contents/suikamongame"></a>
                </div>
                <div class="thumbnail" style="background-image:url('https://pbs.twimg.com/media/GDI59zPawAAE8hW.png')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4d card-h3d card-h2d">
                <div class="note">
                    <div class="text">
                        <h3 class="content-1">C103<wbr>参戦記<wbr>（上）<wbr>「お針子<wbr>シャーロット<wbr>エース」</h3>
                        <p class="content-2">2024-01-03</p>
                        <p class="content-3">
                            今回の冬コミ衣装は、自作・既製品の改造と結構力を入れて作ったので、そちらの記録も残しておこうと思います。カフェさんのスカートは、左右非対称な孤を描く裾が特徴です。これは脚や裏地のがどのくらい見えるかを決めるかなり大事な作業なので、調整には苦労しました。……
                        </p>
                    </div>
                    <a href="https://note.com/units_si/n/nbecfd6dbd172"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/note.png" width="80" height="30" alt="note.com">
                </div>
                <div class="thumbnail" style="background-image:url('https://assets.st-note.com/production/uploads/images/126457701/rectangle_large_type_2_8a8775499acfa7ac9a80e358342a30c3.png')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4d card-h3d card-h2d">
                <div class="twitter">
                    <div class="text">
                        <h3 class="content-1">C103告知動画<wbr> (天然ウナギ専門店)</h3>
                        <p class="content-2">2023-12-29</p>
                        <p class="content-3"></p>
                    </div>
                    <img src="../images/logo/twitter.png" width="29" height="30" alt="twitter.com">
                    <a href="https://twitter.com/41_36_22/status/1740721849204638129"target="_blank" rel="noopener noreferrer"></a>
                </div>
                <div class="thumbnail" style="background-image:url('../images/thumbnails/t20231230001.png')"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4e card-h3e card-h2e">
                <div class="ace">
                    <div class="text">
                        <h3 class="content-1">シャーロットエースの<wbr>部屋</h3>
                        <p class="content-2">2023-12-20</p>
                        <p class="content-3">
                            このWebサイトです。カードをクリックするとトップページに遷移します。
                        </p>
                    </div>
                    <img src="../images/logo/ace.png" width="30" height="30" alt="ace's logo">
                    <a href="https://charlotteace.github.io"></a>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-h4c card-h3b card-h2d">
                <div class="note">
                    <div class="text">
                        <h3 class="content-1">C102参戦記<wbr>　準備期間の<wbr>お話<wbr>（下）</h3>
                        <p class="content-2">2023-08-19</p>
                        <p class="content-3">
                            今回はまだお話していなかったコスプレ準備についてです。コミケ直前まで黙っていたため、まだ未公開の画像もいくつかお見せできるかと思います。今回着用した衣装は、1日目がアルバイト先……
                        </p>
                    </div>
                    <a href="https://note.com/units_si/n/ned0f47cf2ad1"target="_blank" rel="noopener noreferrer"></a>
                    <img src="../images/logo/note.png" width="80" height="30" alt="note.com">
                </div>
                <div class="thumbnail" style="background-image:url('https://assets.st-note.com/img/1692360106315-0uZzouXtzz.png')"></div>
            </div>
        </div>
        <!-- 逆たまコンピの上でいったん改行位置 -->
        {allPosts.map((post) => <BlogPost param={post.frontmatter.param}/>)}
    </div>
</BaseLayout>