---
import AddHeaderFooter from '@src/layouts/AddHeaderFooter.astro';
/*import Card from '../components/Card.astro';*/
const { pageTitle } = Astro.props;
const canonical = "/";
const noindex = true;
---

<AddHeaderFooter pageTitle={ pageTitle } canonical={ canonical } noindex={ noindex }>
  <div id="wrapper">
    <div id="title">
      <h1>404 not found</h1>
    </div>
    <div id="main">
      <h2>部屋からのお知らせ</h2>
      <p>&emsp;このページは存在しません。<a href="https://charlotteace.github.io">トップページ</a>をご覧ください。</p>
        <p>&emsp;現在ページ改修中のため、正しいurlを入力していてもリンクが存在しない場合がございます。更新の反映までしばらくお待ちください。</p>
    </div>
  </div>
</AddHeaderFooter>