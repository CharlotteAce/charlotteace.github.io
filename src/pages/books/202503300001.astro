---
import LayoutBlog from '@src/layouts/LayoutBlog.astro';
const pageTitle = "カゲフミ！　vol. 2　追加Webコンテンツ";
const pageUrl = "";
const pubDate = "2025-03-30";
const updateDate = "2025-03-30";
const description = "既刊「カゲフミ！　vol. 2」購入者向けページ";
const tags :string[] = ["制作物", "同人活動", "ウマ娘"];
---

<LayoutBlog pageTitle={pageTitle} pageUrl={pageUrl} pubDate={pubDate} updateDate={updateDate} description={description} tags={tags}>
