---
import A from '@src/components/A.astro';

const { pageUrl } = Astro.props;
const { pageTitle } = Astro.props;

// const siteUrl = new URL(import.meta.env.SITE ?? '');
---

<style>
  .footer_wrapper {
    position: sticky;
    top: 100vh;
    top: 100dvh;
    color: white;
    background-color: var(--header-bg-color);
    border-top: 1px solid var(--header-border-color);
    margin-top: 4rem;
    margin-bottom: 0;
  }
  #footer{
    margin-top: 1.2rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .footer_contents{
    margin: 3.2rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3.2rem;
  }
  #footer li{
    margin: 0;
    list-style-type: none;
    text-align: left;
    line-height: 2.4rem;
  }
  #footer li ul{
    margin-left: 1.6rem;
  }
  #footer a{
    color: white;
  }
  #footer a:hover,#footer a:focus{
    color: var(--header-bg-color);
    background-color: white;
    text-decoration: none;
  }
  @media screen and (max-width: 588px) {  
    .footer_contents{
      margin: 3.2rem 0;
      display: block;
      justify-content: left;
    }   
    .footer_contents li ul{
      margin-bottom: 3.2rem;
    }
  }
</style>
<div class="footer_wrapper">
  <div id="footer">
    <ul class="footer_contents">
      <li>
        コンテンツ
        <ul>
          <li><small><A href="/">トップページ</A></small></li>
          <li><small><A href="/profile">プロフィール</A></small></li>
          <li><small><A href="/contents">制作物・記事一覧</A></small></li>
          <!--li><small><A href="/contents">支援のお願い</A></small></li-->
        </ul>
      </li>
      <li>
        アカウント
        <ul>
          <li><small><A href="https://x.com/Units_SI">X（日常アカウント/国際単位系）</A></small></li>
          <li><small><A href="https://x.com/_shinoharaK">X（同人活動用/しのはら恵）</A></small></li>
          <li><small><A href="https://note.com/units_si">note</A></small></li>
          <li><small><A href="https://github.com/CharlotteAce/">GitHub</A></small></li>
        </ul>
      </li>
      <li>
        シェア
        <ul>
          <li><small><A href={"https://twitter.com/intent/tweet?text=%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%E3%82%92%E8%A8%AA%E3%82%8C%E3%81%BE%E3%81%97%E3%81%9F%EF%BC%81%0A%0A"+encodeURI(pageTitle)+"%20-%20%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%0A"+encodeURI("https://charlotteace.jp"+pageUrl)}>Xでポスト</A></small></li>
        </ul>
      </li>
    </ul>      
    <small>&copy;Copyright 国際単位系/シャーロットエース. All rights reserved.</small>
  </div>
</div>
