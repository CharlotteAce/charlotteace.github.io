---
const { pageUrl } = Astro.props;
const { pageTitle } = Astro.props;
---

<style>
  .footer_wrapper {
    position: sticky;
    top: 100vh;
    top: 100dvh;
    color: white;
    background-color: var(--header-bg-color);
    border-top: 1px solid var(--header-border-color);
    margin-top: 4rem;
    margin-bottom: 0;
  }
  #footer{
    margin-top: 1.2rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .footer_contents{
    margin: 3.2rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3.2rem;
  }
  #footer li{
    margin: 0;
    list-style-type: none;
    text-align: left;
    line-height: 2.4rem;
  }
  #footer li ul{
    margin-left: 1.6rem;
  }
  #footer a{
    color: white;
  }
  #footer a:hover,#footer a:focus{
    color: var(--header-bg-color);
    background-color: white;
    text-decoration: none;
  }
  @media screen and (max-width: 588px) {  
    .footer_contents{
      margin: 3.2rem 0;
      display: block;
      justify-content: left;
    }   
    .footer_contents li ul{
      margin-bottom: 3.2rem;
    }
  }
</style>
<div class="footer_wrapper">
  <div id="footer">
    <ul class="footer_contents">
      <li>
        コンテンツ
        <ul>
          <li><small><a href="https://charlotteace.github.io">トップページ</a></small></li>
          <li><small><a href="https://charlotteace.github.io/profile">プロフィール</a></small></li>
          <li><small><a href="https://charlotteace.github.io/contents">制作物・記事一覧</a></small></li>
          <!--li><small><a href="https://charlotteace.github.io/contents">支援のお願い</a></small></li-->
        </ul>
      </li>
      <li>
        アカウント
        <ul>
          <li><small><a href="https://x.com/Units_SI" target="_blank" rel="noopener noreferrer">X（日常アカウント/国際単位系）</a></small></li>
          <li><small><a href="https://x.com/_shinoharaK" target="_blank" rel="noopener noreferrer">X（同人活動用/しのはら恵）</a></small></li>
          <li><small><a href="https://note.com/units_si" target="_blank" rel="noopener noreferrer">note</a></small></li>
          <li><small><a href="https://github.com/CharlotteAce/" target="_blank" rel="noopener noreferrer">GitHub</a></small></li>
        </ul>
      </li>
      <li>
        シェア
        <ul>
          <li><small><a href={"https://twitter.com/intent/tweet?text=%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%E3%82%92%E8%A8%AA%E3%82%8C%E3%81%BE%E3%81%97%E3%81%9F%EF%BC%81%0A%0A"+encodeURI(pageTitle)+"%20-%20%E3%82%B7%E3%83%A3%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E3%82%A8%E3%83%BC%E3%82%B9%E3%81%AE%E9%83%A8%E5%B1%8B%0Ahttps%3A%2F%2Fcharlotteace.github.io"+encodeURI(pageUrl)} target="_blank" rel="noopener noreferrer">Xでポスト</a></small></li>
        </ul>
      </li>
    </ul>      
    <small>&copy;Copyright 国際単位系/シャーロットエース. All rights reserved.</small>
  </div>
</div>
