<style>
  .header-wrapper {
    position: sticky;
    top: 1.6rem;
    height: 4.8rem;
    z-index: 1000;
    margin: 0 auto;
    overflow: visible;
  }
  #div-header {
    color: var(--header-font-color);
    background-color: var(--header-bg-color);
    border: 1px solid var(--header-border-color);
    border-radius: 1.6rem;
    overflow: hidden;
    justify-content: space-between;
    transition:
      transform 0.5s ease,
      opacity 0.5s ease;
  }
  #div-header.hidden {
    transform: translateY(-120%);
    opacity: 0;
  }
  #nav_button:checked ~ #div-header,
  #div-header:has(#nav_button:checked) {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }
  #nav div {
    display: block;
    border-top: 1px solid var(--charlotteace-theme);
    font-size: 2rem;
    margin: 0 2rem;
  }
  .nav_button span {
    font-size: 2rem;
    line-height: 4rem;
  }
  #nav div, .nav_button span {
    padding: 0.5rem 0;
  }
  #nav {
    padding: 0;
  }
  #nav a {
    text-decoration: none;
    color: var(--header-font-color);
    margin: 0;
    padding: 0;
    width: 100%;
    line-height: 4rem;
    display: block;
  }
  
  #nav a:focus, .nav_button:focus {
    background-color: var(--header-bg-color);
  }
  /* :hover,:any-hoverに非対応なブラウザ向けのフォールバック */
  #nav a:hover, .nav_button:hover {
    background-color: var(--header-border-color);
  }  
  @media (hover:none){ 
    #nav a:hover, .nav_button:hover {
      background-color: var(--header-bg-color);
    }
    #nav a:active, .nav_button:active {
      background-color: var(--header-border-color);
    }
  }
  @media (any-hover:hover){
    #nav a:hover, .nav_button:hover {
      background-color: var(--header-border-color);
    }
  }
  #nav a:focus-visible, #nav_button:focus-visible + .nav_button {
    color: var(--header-font-focus);
    background-color: var(--header-bg-focus);
  }
  /*!--メニューボタン周りの実装--*/    
  #nav_button {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none; /* マウス操作はlabelに任せる */
  }
  .nav_button {
    display: inline-block;
    width: 100%;
    margin: 0;
    padding: 0 2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /*
  #nav_button + .nav_button::after {
    content: "";
  }
  #nav_button:checked + .nav_button::after {
    content: "シャーロットエースの部屋";
  }
  */
  .nav_menu{
    display: none;
  }
  #nav_button:checked+label+.nav_menu{
    display: initial;
  } 

  /* hamburger */
  .hamburger {
    position: relative;
    right: 0px;
    width: 3rem;
    height: 2.5rem;
    display: inline-block;
  }

  .hamburger span {
    position: absolute;
    margin: 0;
    padding: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--header-font-color);
    transition: 0.3s;
  }
  #nav_button:focus-visible+.nav_button .hamburger span {
    background: var(--header-font-focus);
  }
  
  /* 3本線配置 */
  .hamburger span:nth-child(1) {
    top: 0;
  }
  
  .hamburger span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  
  .hamburger span:nth-child(3) {
    bottom: 0;
  }
  
  /* checked状態（X化） */
  #nav_button:checked + label .hamburger span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  
  #nav_button:checked + label .hamburger span:nth-child(2) {
    opacity: 0;
  }
  
  #nav_button:checked + label .hamburger span:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }
</style>
<div class="header-wrapper" ontouchstart="">
  <div id="div-header">                
    <input type="checkbox" id="nav_button" />
    <label class="nav_button" for="nav_button" role="button" aria-haspopup="true" ontouchstart="">
      <span>シャーロットエースの部屋</span>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </label>      
    <div id="nav" class="nav_menu">
      <a href="/"><div>トップ</div></a>
      <a href="/contents"><div>記事・制作物</div></a>
    </div>
  </div>
</div>
<script>
  const header = document.getElementById("div-header");
  const navButton = document.getElementById("nav_button");

  if (!header) {
    throw new Error("header not found");
  }
  if (!(navButton instanceof HTMLInputElement)) {
    throw new Error("nav_button not found");
  }

  let lastScrollY = window.scrollY;

    // ヘッダー外クリックでメニューを閉じる
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Node)) {
      return;
  }

    if (!header.contains(target)) {
      navButton.checked = false;
    }
  });

  // Escキーでも閉じる
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      navButton.checked = false;
      // Escを押したときfocusを解除
      navButton.blur();

      if (document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }
    }
  });
  window.addEventListener("scroll", () => {
    const currentScrollY = window.scrollY;
    const stickyThreshold = 96;

    // 最上部では必ず表示
    if (currentScrollY <= 0) {
      header.classList.remove("hidden");
      lastScrollY = currentScrollY;
      return;
    }

    // sticky位置に達するまでは常時表示
    if (currentScrollY < stickyThreshold) {
      header.classList.remove("hidden");
      lastScrollY = currentScrollY;
      return;
    }

    // 下スクロール → 非表示
    if (currentScrollY > lastScrollY) {
      header.classList.add("hidden");
    }
    // 上スクロール → 表示
    else {
      header.classList.remove("hidden");
    }

    lastScrollY = currentScrollY;
  });
  
</script>